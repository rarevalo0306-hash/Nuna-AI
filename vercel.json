{
  "functions": {
    "api/images.js": {
      "maxDuration": 180
    },
    "api/videos.js": {
      "maxDuration": 120
    },
    "api/memory.js": {
      "maxDuration": 60
    },
    "api/documents.js": {
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 90
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.or-nuna.com"
        }
      ],
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.or-nuna.com"
        }
      ],
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
