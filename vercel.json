{
  "functions": {
    "api/images.js": {
      "maxDuration": 180
    },
    "api/videos.js": {
      "maxDuration": 120
    },
    "api/memory.js": {
      "maxDuration": 60
    },
    "api/documents.js": {
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 90
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.or-nuna.com"
        }
      ],
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "admin.or-nuna.com"
        }
      ],
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
