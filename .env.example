# Copia a Vercel (Settings → Environment Variables). Nunca pongas valores reales en el repositorio.

# Código de administrador: uso de la IA sin límite diario (mínimo 16 caracteres, aleatorio)
NUNA_ACCESS_CODE=

# OpenAI
OPENAI_API_KEY=
NUNA_OPENAI_MODEL=gpt-4.1-mini

# Anthropic (obligatorio indicar el ID exacto del modelo disponible en tu cuenta)
ANTHROPIC_API_KEY=
NUNA_ANTHROPIC_MODEL=claude-opus-5-5
# Razonamiento de Claude Opus 5 / 5.5, Fable 5 y Sonnet 5.5: low (por defecto), medium, high, xhigh o max
NUNA_ANTHROPIC_EFFORT=low

# DeepSeek
DEEPSEEK_API_KEY=
NUNA_DEEPSEEK_MODEL=deepseek-chat

# Google Gemini
GEMINI_API_KEY=
NUNA_GEMINI_MODEL=gemini-flash-latest

# Grok (xAI) (obligatorio indicar el ID exacto del modelo disponible en tu cuenta)
XAI_API_KEY=
NUNA_GROK_MODEL=grok-4.7

# Qwen (Alibaba Cloud Model Studio / DashScope, modo compatible)
DASHSCOPE_API_KEY=
NUNA_QWEN_MODEL=qwen-plus
# Internacional por defecto; para China continental usa https://dashscope.aliyuncs.com/compatible-mode/v1
NUNA_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Supabase (cuentas). Valores públicos: el acceso lo controla Row Level Security.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Mensajes de IA por cuenta y día (UTC)
NUNA_DAILY_LIMIT=30
# Cuentas de administrador sin límite diario (correos separados por comas)
NUNA_ADMIN_EMAILS=

# Private LM Studio trial, enabled only for this verified account. Qwen cloud remains fallback.
NUNA_LOCAL_QWEN_EMAIL=
NUNA_LOCAL_QWEN_URL=
NUNA_LOCAL_QWEN_KEY=
NUNA_LOCAL_QWEN_MODEL=unsloth/Qwen3.5-9B-GGUF
# false: the allowlisted local account never falls back to a paid cloud provider.
NUNA_LOCAL_QWEN_FALLBACK=false
